<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="material_purchase_requisition_form_view" model="ir.ui.view">
            <field name="name">material.purchase.requisition.form.view</field>
            <field name="model">cdx.material.purchase.requisition</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button class="btn-primary" invisible="state not in ['draft']" name="create_rfq" string="Create RFQ" type="object" groups="purchase.group_purchase_manager,purchase.group_purchase_user"/>
                        <button groups="base.group_user" invisible="state not in ['draft']" name="action_cancel" string="Cancel" type="object"/>
                        <button class="btn-primary" invisible="state not in ['cancel']" name="reset_draft" string="Reset to Draft" type="object"/>
                        <field name="state" statusbar_visible="draft,sent,purchase,cancel" string="confirm" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-book" name="action_show_qo" type="object" groups="purchase.group_purchase_manager,purchase.group_purchase_user">
                                <field help="PO" name="count_rfq" string="Quotations" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" icon="fa-book" name="action_show_po" type="object">
                                <field help="PO" name="count_po" string="Purchase Orders" widget="statinfo"/>
                            </button>
                             <button class="oe_stat_button" icon="fa-book" name="action_show_mr" strin="Material Request" type="object" groups="purchase.group_purchase_manager,purchase.group_purchase_user">
                                <field help="PO" name="count_mr" string="Material Request" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <div class="oe_title">
                                <h1>
                                    <field name="name"/>
                                    <br/>
                                </h1>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="requisiton_requested_id" readonly="state != 'draft'"/>
                                <field name="request_date" readonly="state != 'draft'"/>
                                <field groups="base.group_multi_company" name="company_id" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="origin"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Requisitions Lines">
                                <field name="requisition_line_ids" readonly="state not in 'draft'">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="qty"/>
                                        <field name="uom"/>
                                        <field name="on_hand"  widget="stock_availability_widget"/>
                                        <field name="partner_id" required="1" widget="many2many_tags"/>
                                    </tree></field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form></field>
        </record>
        <record id="material_purchase_requisition_tree_view" model="ir.ui.view">
            <field name="name">material.purchase.requisition.view.tree</field>
            <field name="model">cdx.material.purchase.requisition</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="request_date"/>
                    <field groups="base.group_multi_company" name="company_id"/>
                    <field name="state"/>
                </tree></field>
        </record>
        <record id="action_material_purchase_requisition" model="ir.actions.act_window">
            <field name="name">Purchase Requisitions</field>
            <field name="res_model">cdx.material.purchase.requisition</field>
            <!--<field name="view_type">form</field>-->
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem action="action_material_purchase_requisition" id="menu_purchase_requisition" name="Purchase Requisition" parent="cdx_perfumer.menu_mr" sequence="3"/>
    </data>
</odoo>
