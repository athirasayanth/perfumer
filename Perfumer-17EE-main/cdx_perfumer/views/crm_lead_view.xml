                <div class="o_lead_opportunity_form_inline_fields" position="after">
                    <label for="date_deadline_delivery">Expected Delivery</label>
                    <div class="o_lead_opportunity_form_inline_fields">
                        <field name="date_deadline_delivery" nolabel="1" class="oe_inline"/>
                    </div>
                    <label for="task_timer"/>
                    <div class="o_row" style="display: inline-block;">
                        <field name="task_timer" widget="boolean_toggle" invisible="1"/>
                    </div>
                </div>
                <xpath expr="//header" position="inside">

                    <field name="show_timer" invisible="1"/>
                    <label for="duration" invisible="show_timer != True"/>
                    <div>
                        <field name="duration" id="duration" widget="task_timer"
                               style="color: red;" invisible="show_timer != True"/>
                    </div>
                    <field name="is_user_working" invisible="1"/>
                </xpath>
                <page name="internal_notes" position="after">
                    <page name="timesheet" string="Timesheet">
                        <field name="timesheet_ids" nolabel="1">
                            <tree>
                                <field name="readonly_timesheet" column_invisible="True"/>
                                <field name="date" readonly="readonly_timesheet"/>
                                <field name="user_id"/>
                                <field name="unit_amount" widget="timesheet_uom" string="Time Spent"
                                       decoration-danger="unit_amount &gt; 24 or unit_amount &lt; 0"
                                       readonly="readonly_timesheet"/>

                            </tree>
                        </field>
                    </page>
                </page>
                <xpath expr="//page[@name='lead']" position="attributes">
                    <attribute name="invisible"/>
                </xpath>

                <xpath expr="//group[@name='lead_partner']" position="attributes">
                    <attribute name="invisible"/>
                </xpath>

                <xpath expr="//group[@name='lead_partner']/field[@name='partner_name']" position="replace">
                </xpath>

                <xpath expr="//group[@name='lead_partner']/field[@name='website']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='lead_partner']/field[@name='lang_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='lead_priority']/field[@name='tag_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='user_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='team_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='lead_info']" position="replace">

                </xpath>
                <xpath expr="(//group)[4]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="(//group)[5]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//group[@name='lead_partner']" position="attributes">
                    <attribute name="string">Basic Information</attribute>
                </xpath>
                <xpath expr="//group[@name='lead_partner']/field[@name='partner_id']" position="after">
                    <field name="contact_name" string="Primary Contact Person" style="width:400px;"/>
                    <field name="email_from" string="Email Address" style="width:400px;"/>
                    <field name="phone" string="Phone Number" style="width:300px;"/>
                    <field name="mobile" string="Alternate Phone Number" style="width:300px;"/>
                </xpath>
                <xpath expr="//group[@name='lead_partner']//label[@for='street']" position="attributes">
                    <attribute name="string">Billing Address</attribute>
                </xpath>


                <xpath expr="//group[@name='lead_partner']" position="after">
                    <group string="Shipping Address Details">
                        <field name="same_shipping_address"/>

                        <label for="shipping_street" string="Shipping Address"/>
                        <div class="o_address_format">
                            <field name="shipping_street" placeholder="Street..." style="width:300px;"/>
                            <field name="shipping_street2" placeholder="Street 2..." style="width:300px;"/>

                            <div style="display:flex; gap:10px;">
                                <field name="shipping_city" placeholder="City" style="width:200px;"/>
                                <field name="shipping_state_id" placeholder="State" options="{'no_open': True}"
                                       style="width:200px;"/>
                                <field name="shipping_zip" placeholder="ZIP" style="width:150px;"/>
                            </div>

                            <field name="shipping_country_id" placeholder="Country" style="width:200px;"
                                   options="{'no_open': True, 'no_create': True}"/>
                        </div>


                    </group>
                    <group string="Customer Category">
                        <field name="customer_type"/>
                        <field name="industry_type"/>
                        <field name="customer_segment"/>

                    </group>

                    <group string="Sales/Account Assignment">
                        <field name="user_id"/>
                        <field name="source_id"/>
                    </group>

                    <group string="Financial Information">
                        <field name="payment_term_id"/>
                        <field name="credit_limit"/>
                        <field name="vat_number"/>
                    </group>
                    <group string="Communication Preferences">
                        <field name="preferred_contact_method"/>
                        <field name="marketing_opt_in"/>
                    </group>

                    <group string="Internal Tags and Notes">
                                               <field name="customer_id" readonly="1"/>
                        <field name="first_contact_date" readonly="1"/>
                        <field name="last_contact_date" readonly="1"/>
                    </group>


                </xpath>

            </field>
        </record>

</data>
        </odoo>