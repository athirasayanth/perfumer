    <data>
        <record model="ir.ui.view" id="cdx_inherit_crm_lead_form">
            <field name="name">cdx.crm.lead.inherit.form</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <!-- <field name="tag_ids" position="after">
                    <field name="cdx_is_jobcard_assigned" class="oe_inline" invisible="1" />
