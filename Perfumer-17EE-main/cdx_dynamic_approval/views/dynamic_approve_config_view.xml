<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_dynamic_approve_config_form" model="ir.ui.view">
            <field name="name">dynamic.approve.config.form</field>
            <field name="model">dynamic.approve.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field domain="[('model','in',('sale.order','purchase.order'))]" name="model_id" options="{'no_create':1,'no_create_edit':1}" required="1"/>
                                <field name="approval_levels" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="approval_levels" string="Approval Levels">
                                <field context="{'default_model_id': model_id}"  name="approve_lines" widget="one2many" mode="tree">
                                    <tree create="0" delete="1" editable="bottom">
                                        <!-- <field name="approve_config_id" invisible="1" /> -->
                                        <!-- <field  name="model_id" invisible="1" /> -->
                                        <!-- <field  name="res_model" invisible="model_id" /> -->
                                        <field name="approval_levels" invisible="1" readonly="1" required="1"/>
                                        <field  name="approval_type" readonly="1" required="1" invisible="1"/>
                                        <!-- <field  name="groups_ids" widget="many2many_tags" invisible="1"/> -->
                                        <field  name="user_ids" widget="many2many_tags" invisible="approval_type != 'user'"/>
                                        <!-- <field name="domain" options="{'model': 'res_model'}" widget="domain" invisible="1" /> -->
                                    </tree></field>
                            </page>
                        </notebook>
                    </sheet>
                </form></field>
        </record>
        <record id="view_dynamic_approve_config_tree" model="ir.ui.view">
            <field name="name">dynamic.approve.config.tree</field>
            <field name="model">dynamic.approve.config</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="model_id"/>
                </tree></field>
        </record>
        <record id="action_dynamic_approve_config" model="ir.actions.act_window">
            <field name="name">Dynamic Approval</field>
            <field name="res_model">dynamic.approve.config</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem action="action_dynamic_approve_config" id="main_menu_dynamic_approve" name="Dynamic Approval"  web_icon="cdx_dynamic_approval,static/description/icon.png"/>
        <menuitem action="action_dynamic_approve_config" id="menu_dynamic_approve_config" name="Approval Configuration" parent="main_menu_dynamic_approve"/>
    </data>
</odoo>
